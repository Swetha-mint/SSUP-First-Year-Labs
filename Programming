# 1. Lambda function (Unit 3) to style the game text headers
format_header = lambda title: f"\n================= {title.upper()} ================="

# 2. Recursive function (Unit 3) to compute system latency penalties
# Simulates optimization layers where latency shrinks down recursively
def calculate_latency_penalty(optimization_layers):
    if optimization_layers <= 0:
        return 50 # Base latency penalty in milliseconds
    else:
        # Each layer reduces leftover latency recursively
        return 10 + calculate_latency_penalty(optimization_layers - 1) // 2

# 3. User Defined Function (Unit 3) for the Digital Foundations Stage
def run_vlsi_stage():
    print(format_header("Stage 1: VLSI & Digital Foundations"))
    print("Goal: Build the processing core and Toffoli quantum-inspired logic gates.")
    
    optimizations = 0
    attempts = 3
    
    # While loop (Unit 3) for handling player attempts
    while attempts > 0:
        print(f"\nAttempts remaining: {attempts}")
        print("Choose your RTL focus:")
        print("1. Optimize ALU Core architecture")
        print("2. Implement Toffoli gates for exploratory computing")
        print("3. Skip optimization pass")
        
        choice = input("Enter choice (1-3): ")
        
        # Nested if-else decision control (Unit 3)
        if choice == "1":
            print("-> ALU core successfully streamlined!")
            optimizations += 1
        elif choice == "2":
            print("-> Toffoli gates integrated securely!")
            optimizations += 2
            attempts -= 1  # Costly layout synthesis time
        elif choice == "3":
            print("-> Skipping layout pass.")
            pass # Pass statement (Unit 3) acting as placeholder
            break # Break statement (Unit 3) to exit loop early
        else:
            print("-> Invalid command code input. Try again.")
            continue # Continue statement (Unit 3) to jump to next iteration
            
        attempts -= 1
        
    return optimizations

# 4. User Defined Function (Unit 3) for the Sensory Processing Stage
def run_sensor_stage():
    print(format_header("Stage 2: Sensory Processing & Edge AI"))
    print("Goal: Process sign-language gestural data locally under low latency.")
    
    total_score = 0
    # For loop (Unit 3) to simulate a sequence of incoming gestural signals
    for signal in range(1, 4):
        print(f"\nProcessing real-world gesture batch #{signal}...")
        print("Select processing layer boundary:")
        print("A: Local Edge AI pipeline execution")
        print("B: Cloud fallback relay routing")
        
        choice = input("Select gate (A/B): ")
        
        if choice.upper() == "A":
            print("-> Clear signal interpreted locally with minimal bus delay!")
            total_score += 15
        elif choice.upper() == "B":
            print("-> Alert! Cloud routing introduces high-latency side-channels.")
            total_score += 5
        else:
            print("-> Signal dropped completely due to architectural mismatch.")
            
    return total_score

# 5. Main Game Loop Function (Unit 3)
def start_signalink_game():
    print(format_header("Welcome to Signalink Terminal"))
    print("Mission: Sense -> Process -> Communicate -> Assist")
    print("Develop an open-source, low-latency assistive framework.")
    
    # Execute Stage 1
    opt_layers = run_vlsi_stage()
    
    # Calculate performance using the recursive function
    system_latency = calculate_latency_penalty(opt_layers)
    print(f"\n[SYSTEM PROFILE] Component architecture latency: {system_latency}ms")
    
    # Conditional gate check
    if system_latency > 35:
        print("Warning: Processing core latency limits assistive communication!")
    else:
        print("Success: Ultra low-latency digital foundation established!")
        
    # Execute Stage 2
    sensor_score = run_sensor_stage()
    print(f"\n[FINAL SCORE] Data Pipeline Score: {sensor_score} points.")
    
    # Final game evaluation using nested if-else statements
    if sensor_score >= 30:
        if system_latency <= 35:
            print("\n👑 VICTORY: You engineered the perfect Signalink assistive device!")
        else:
            print("\n⚠️ PARTIAL SUCCESS: System processes gestures well but core hardware lags.")
    else:
        print("\n❌ DEFEAT: The platform failed to handle real-world signals accurately.")

# Trigger the main user-defined function to play
start_signalink_game()
